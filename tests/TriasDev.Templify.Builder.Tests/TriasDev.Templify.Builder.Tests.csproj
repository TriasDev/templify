<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TriasDev.Templify.Builder\TriasDev.Templify.Builder.csproj" />
    <!-- Dogfooding: the invariants below are the test kit's checks (#286). -->
    <ProjectReference Include="..\..\src\TriasDev.Templify.Builder.Testing\TriasDev.Templify.Builder.Testing.csproj" />
    <!-- The sample runs as a test, so CI runs it (#287). -->
    <ProjectReference Include="..\..\samples\TriasDev.Templify.Builder.Sample\TriasDev.Templify.Builder.Sample.csproj" />
    <!-- The typed path generator: tested through CSharpGeneratorDriver, and run on this project like in a client
         (the package ships it under analyzers/dotnet/cs). -->
    <ProjectReference Include="..\..\src\TriasDev.Templify.Builder.Generators\TriasDev.Templify.Builder.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the core tests by linking the source (design spec, section 7): ODT package reading and the
         local LibreOffice round trip. -->
    <Compile Include="..\TriasDev.Templify.Tests\Helpers\OdtDocumentVerifier.cs" Link="Shared\OdtDocumentVerifier.cs" />
    <Compile Include="..\TriasDev.Templify.Tests\Helpers\OdtDocumentBuilder.cs" Link="Shared\OdtDocumentBuilder.cs" />
    <Compile Include="..\TriasDev.Templify.Tests\Odt\LibreOfficeRunner.cs" Link="Shared\LibreOfficeRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- A font no machine has installed, for the embedding tests (Fixtures/README.md). -->
    <EmbeddedResource Include="Fixtures\TemplifyEmbedTest-Regular.ttf" LogicalName="TemplifyEmbedTest-Regular.ttf" />
  </ItemGroup>

</Project>
