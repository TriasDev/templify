<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Run the core tests against every library TFM (keep in sync with TriasDev.Templify.csproj). -->
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <!-- LibreOffice-authored templates (sources in Odt/Fixtures/Sources); processed without LibreOffice at test time. -->
    <None Include="Odt\Fixtures\*.odt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TriasDev.Templify\TriasDev.Templify.csproj" />
  </ItemGroup>

</Project>
