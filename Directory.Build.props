<Project>
  <!-- Settings every project in the repository shares. src/ and tests/ each add their own on top through a
       Directory.Build.props that imports this one; tools/, benchmarks/ and samples/ use this file alone.
       Project-specific settings (target frameworks, package identity) stay in the individual .csproj files. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- `latest` (default rule set). `latest-recommended` currently reports ~3,000 warnings
         (mostly CA1707 underscores in test names, CA1510, CA1822, CA1861); enable it once those are addressed. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Report .editorconfig code-style (IDExxxx) violations during build, not only in `dotnet format`. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Nullable warnings are always errors (also locally): they point to real null dereferences. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <!-- packages.lock.json per project: reproducible restores and the NuGet cache key in CI. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- CI builds (GitHub Actions): normalized source paths for reproducible builds.
       Locked restores (fail if packages.lock.json is out of date) are requested by the workflows
       (the locked-mode option of `dotnet restore`, or RestoreLockedMode=true as a property), not here: Dependabot's NuGet updater
       also runs with GITHUB_ACTIONS=true, restores one target framework at a time and fails with NU1004
       in locked mode, so it silently opened no update PRs. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Warnings fail CI builds, but do not block local development.
       NuGet vulnerability audit warnings (NU1900-NU1904) stay warnings so that a newly published
       advisory does not break unrelated builds; dependency updates are handled by Dependabot. -->
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
