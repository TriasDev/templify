<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Same TFMs as the core library (TriasDev.Templify.csproj). -->
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>

    <!-- NuGet package identity; shared package metadata is in src/Directory.Build.props.
         Own version line, 0.x until the API has carried one real document (design spec, D7). -->
    <PackageId>TriasDev.Templify.Builder</PackageId>
    <!-- version.txt is the builder's single version source: release-please (component "builder") updates it, and the
         test kit reads the same file. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.txt').Trim())</Version>
    <Description>Code-first template builder for TriasDev.Templify: describe Word (.docx) and OpenDocument Text (.odt) templates in C# — styles, placeholders, conditionals and loops — and generate them at runtime. Templify fills the generated templates.</Description>
    <PackageTags>word;docx;odt;opendocument;libreoffice;template;templify;document-generation;templating;builder;fluent</PackageTags>
    <!-- No PackageValidationBaselineVersion until the first release; then the previous 0.x release (CONTRIBUTING.md,
         "Builder releases"). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Typed WordprocessingML elements only; the builder writes the package itself (deterministic output). -->
    <PackageReference Include="DocumentFormat.OpenXml"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The builder uses the core library's public API only (design spec, D8). -->
    <ProjectReference Include="..\TriasDev.Templify\TriasDev.Templify.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TriasDev.Templify.Builder.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The typed path source generator ships inside this package (analyzers/dotnet/cs), so a definition gets
         order.Number instead of order.Path(o => o.Number) without installing anything. -->
    <ProjectReference Include="..\TriasDev.Templify.Builder.Generators\TriasDev.Templify.Builder.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"/>
    <None Include="..\TriasDev.Templify.Builder.Generators\bin\$(Configuration)\netstandard2.0\TriasDev.Templify.Builder.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
